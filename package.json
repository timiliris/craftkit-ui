{
  "name": "craftkit-ui",
  "private": true,
  "version": "0.1.0",
  "description": "CraftKit UI: standalone Minecraft GUI theme for the web (Tailwind CSS v4 / shadcn tokens, or one plain stylesheet).",
  "license": "MIT",
  "author": "Timiliris",
  "homepage": "https://timiliris.github.io/craftkit-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timiliris/craftkit-ui.git"
  },
  "bugs": {
    "url": "https://github.com/timiliris/craftkit-ui/issues"
  },
  "keywords": [
    "minecraft",
    "css",
    "theme",
    "tailwindcss",
    "shadcn",
    "pixel-art",
    "gui"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "serve": "node serve.mjs",
    "dev": "node build.mjs && node serve.mjs",
    "mc:setup": "node theme/scripts/extract-textures.mjs && node theme/scripts/build-derived-sprites.mjs && node theme/scripts/build-font.mjs",
    "install-into": "node tools/install.mjs",
    "mc:fetch-jar": "node tools/fetch-jar.mjs"
  },
  "dependencies": {
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "adm-zip": "0.6.1",
    "opentype.js": "2.0.0",
    "pngjs": "7.0.0",
    "wawoff2": "2.0.1"
  }
}
